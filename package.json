{
  "name": "askstar",
  "private": true,
  "version": "0.2.5",
  "type": "module",
  "scripts": {
    "convert-data": "node scripts/convertAllLanguages.js",
    "convert-ko": "node scripts/convertSheetToJson_ko.js",
    "convert-en": "node scripts/convertSheetToJson_en.js",
    "build-articles": "node scripts/buildArticles.js",
    "update-articles": "node scripts/updateArticles.js",
    "rebuild-all": "node scripts/rebuildAll.js",
    "protect-article": "node scripts/protectArticle.js",
    "unprotect-article": "node scripts/unprotectArticle.js",
    "list-protected": "node scripts/listProtected.js",
    "dev": "vite",
    "dev:fresh": "npm run convert-data && vite",
    "build": "tsc -b && vite build && node scripts/prepare-static.mjs",
    "build:fresh": "npm run convert-data && npm run build-articles && npm run build",
    "deploy": "npx vercel --prod",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy:firebase": "./node_modules/.bin/firebase deploy --only hosting",
    "typecheck": "tsc -b",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@notionhq/client": "^4.0.1",
    "circular-natal-horoscope-js": "^1.1.0",
    "dotenv": "^16.5.0",
    "google-spreadsheet": "^3.3.0",
    "nanoid": "^5.1.5",
    "node-geocoder": "^4.4.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@heroicons/react": "^2.2.0",
    "@types/node-geocoder": "^4.2.6",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "firebase-tools": "^14.11.0",
    "framer-motion": "^12.12.1",
    "globals": "^16.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": "22.x"
  }
}
